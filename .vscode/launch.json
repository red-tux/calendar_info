{
  // Debug StreamController with this plugin loaded (dev container). Breakpoints in this
  // repo work because the app loads the plugin from the very same path VS Code edits.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StreamController (devel)",
      "type": "debugpy",
      "request": "launch",
      "program": "/workspaces/StreamController/main.py",
      "args": ["--devel", "--data", "data", "--close-running"],
      "cwd": "/workspaces/StreamController",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "StreamController (devel, no hardware)",
      "type": "debugpy",
      "request": "launch",
      "program": "/workspaces/StreamController/main.py",
      "args": ["--devel", "--data", "data", "--close-running", "--skip-load-hardware-decks"],
      "cwd": "/workspaces/StreamController",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" }
    },
    {
      "name": "Plugin unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", "."],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
